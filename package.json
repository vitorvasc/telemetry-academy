{
  "name": "telemetry-academy",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:csp": "node scripts/check-csp.mjs",
    "doctor": "react-doctor .",
    "doctor:diff": "react-doctor . --scope changed --base main --verbose",
    "prepare": "husky"
  },
  "dependencies": {
    "@datadog/browser-rum": "^7.13.0",
    "@datadog/browser-rum-react": "^7.13.0",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@tailwindcss/typography": "^0.5.19",
    "lucide-react": "^1.16.0",
    "pyodide": "^314.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "wouter": "^3.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@modyfi/vite-plugin-yaml": "1.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "10.6.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-dom": "5.28.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-x": "5.28.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "js-yaml": "5.5.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
